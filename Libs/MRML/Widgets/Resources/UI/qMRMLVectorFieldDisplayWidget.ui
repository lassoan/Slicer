       </property>
      </widget>
     </item>
     <item row="7" column="0">
      <widget class="QLabel" name="MaskingNthPointLabel">
       <property name="text">
        <string>N:</string>
       </property>
      </widget>
     </item>
     <item row="7" column="1">
      <widget class="QSpinBox" name="MaskingNthPointSpinBox">
       <property name="toolTip">
