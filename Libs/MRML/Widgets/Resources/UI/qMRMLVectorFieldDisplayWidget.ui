    <number>0</number>
   </property>
   <property name="bottomMargin">
    <number>0</number>
   </property>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <property name="fieldGrowthPolicy">
      <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
     </property>
     <item row="0" column="0">
      <widget class="QLabel" name="VisibilityLabel">
       <property name="text">
        <string>Visibility:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QCheckBox" name="VisibilityCheckBox">
       <property name="toolTip">
        <string>Show these glyphs in all views. Visibility can be restricted to 3D or slice views in the 3D display and Slice display sections.</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="GlyphTypeLabel">
       <property name="text">
        <string>Glyph type:</string>
       </property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QComboBox" name="GlyphTypeComboBox">
       <property name="toolTip">
        <string>Shape used to represent each glyph.</string>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="OrientationArrayLabel">
       <property name="text">
        <string>Orientation array:</string>
       </property>
      </widget>
     </item>
     <item row="2" column="1">
      <layout class="QHBoxLayout" name="orientationArrayLayout">
       <item>
        <widget class="QComboBox" name="OrientationArrayComboBox">
         <property name="toolTip">
          <string>3-component point data array used to orient each glyph. If None, glyphs are not oriented.</string>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QToolButton" name="SwapOrientationArrayCoordinateSystemButton">
         <property name="toolTip">
          <string>Convert the selected orientation array between the RAS and LPS coordinate systems, by inverting the sign of the first two components of each vector. The array of the model node is modified.</string>
         </property>
         <property name="text">
          <string>RAS/LPS</string>
         </property>
        </widget>
       </item>
      </layout>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="ScaleArrayLabel">
       <property name="text">
        <string>Scale array:</string>
       </property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QComboBox" name="ScaleArrayComboBox">
       <property name="toolTip">
        <string>Point data array used to scale each glyph. If None, glyphs are only scaled by Scale factor.</string>
       </property>
      </widget>
     </item>
     <item row="4" column="0">
      <widget class="QLabel" name="VectorScaleModeLabel">
       <property name="text">
        <string>Vector scale mode:</string>
       </property>
      </widget>
     </item>
     <item row="4" column="1">
      <widget class="QComboBox" name="VectorScaleModeComboBox">
       <property name="toolTip">
        <string>How to use a 3-component scale array to scale the glyph. Only enabled if the selected scale array has 3 components.</string>
       </property>
      </widget>
     </item>
     <item row="5" column="0">
      <widget class="QLabel" name="ScaleFactorLabel">
       <property name="text">
        <string>Scale factor:</string>
       </property>
      </widget>
     </item>
     <item row="5" column="1">
      <widget class="ctkDoubleSpinBox" name="ScaleFactorSpinBox">
       <property name="toolTip">
        <string>Factor used to scale the glyph geometry.</string>
       </property>
       <property name="decimalsOption">
        <set>ctkDoubleSpinBox::DecimalsByShortcuts|ctkDoubleSpinBox::InsertDecimals|ctkDoubleSpinBox::ReplaceDecimals</set>
       </property>
       <property name="minimum">
        <double>0.000000000000000</double>
       </property>
       <property name="maximum">
        <double>1000000.000000000000000</double>
       </property>
       <property name="singleStep">
        <double>1.000000000000000</double>
       </property>
      </widget>
     </item>
